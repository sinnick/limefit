{
  "name": "limefit",
  "version": "2.0.0",
  "scripts": {
    "start": "APP_BRAND=levelgym EXPO_PUBLIC_BRAND=levelgym expo start --dev-client",
    "start:limefit": "APP_BRAND=limefit EXPO_PUBLIC_BRAND=limefit expo start --dev-client --clear",
    "start:levelgym": "APP_BRAND=levelgym EXPO_PUBLIC_BRAND=levelgym expo start --dev-client --clear",
    "android": "APP_BRAND=levelgym EXPO_PUBLIC_BRAND=levelgym expo run:android",
    "android:limefit": "APP_BRAND=limefit EXPO_PUBLIC_BRAND=limefit expo run:android",
    "android:levelgym": "APP_BRAND=levelgym EXPO_PUBLIC_BRAND=levelgym expo run:android",
    "ios": "APP_BRAND=levelgym EXPO_PUBLIC_BRAND=levelgym expo run:ios",
    "ios:limefit": "APP_BRAND=limefit EXPO_PUBLIC_BRAND=limefit expo run:ios",
    "ios:levelgym": "APP_BRAND=levelgym EXPO_PUBLIC_BRAND=levelgym expo run:ios",
    "prebuild:limefit": "APP_BRAND=limefit EXPO_PUBLIC_BRAND=limefit expo prebuild --clean",
    "prebuild:levelgym": "APP_BRAND=levelgym EXPO_PUBLIC_BRAND=levelgym expo prebuild --clean",
    "web": "APP_BRAND=levelgym EXPO_PUBLIC_BRAND=levelgym expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.6",
    "@react-navigation/native-stack": "^6.9.12",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.17.0",
    "axios": "^1.4.0",
    "expo": "^56.0.8",
    "expo-camera": "~56.0.7",
    "expo-checkbox": "~56.0.1",
    "expo-dev-client": "~56.0.18",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-notifications": "~56.0.15",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "tailwindcss": "^3.4.1",
    "twrnc": "^4.16.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.2.14",
    "typescript": "~6.0.3"
  },
  "private": true
}
